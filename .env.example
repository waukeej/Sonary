# Generate a unique random value; never commit your real .env.
SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sonary
DB_USER=sonary
DB_PASSWORD=replace-with-your-local-database-password
# false for local HTTP; true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false

